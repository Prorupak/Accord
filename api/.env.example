# Server-only. Never expose these to the browser or commit a filled-in copy.
OPENROUTER_API_KEY=
# Pick a model that supports structured outputs (strict JSON schema); free models end in ":free".
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Docker only (compose.yaml sets it): also trust Host "<name>:API_PORT" from the internal network.
# API_INTERNAL_HOST=
# Dev only: log raw model output. It contains cell values, so keep it off otherwise.
# LOG_MODEL_OUTPUT=false
# Abuse limits, shared by all callers, in memory per process (reset on restart). Defaults shown.
# RATE_LIMIT_MAP_PER_MINUTE=6
# RATE_LIMIT_SUGGEST_PER_MINUTE=12
# Every OpenRouter attempt counts, including retries and the repair attempt.
# PROVIDER_ATTEMPTS_PER_DAY=30
