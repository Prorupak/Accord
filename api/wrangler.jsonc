// Private Python Worker for the FastAPI app (docs/cloudflare-deploy.md). No public URL in any
// environment: the only way in is the gateway's service binding, which calls http://accord-api:8000.
{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "accord-api",
  // `worker/` is the module root so .venv/ and tests/ are never uploaded. scripts/worker.sh copies
  // app/ into worker/app/ (gitignored) before each pywrangler run; app/ itself stays the only source.
  "main": "worker/entry.py",
  "base_dir": "worker",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Matches the existing Host guard (app/http.py): "<API_INTERNAL_HOST>:<API_PORT>".
  "vars": { "API_INTERNAL_HOST": "accord-api", "API_PORT": "8000" },
  "env": {
    "staging": {
      "name": "accord-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "API_INTERNAL_HOST": "accord-api",
        "API_PORT": "8000",
        "OPENROUTER_MODEL": "nvidia/nemotron-3.5-super-vl:free"
      }
    },
    "production": {
      "name": "accord-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "API_INTERNAL_HOST": "accord-api",
        "API_PORT": "8000",
        "OPENROUTER_MODEL": "nvidia/nemotron-3.5-super-vl:free"
      }
    }
  }
  // OPENROUTER_API_KEY is a per-environment secret: `uv run pywrangler secret put OPENROUTER_API_KEY --env <env>`.
}
