# Root .env is read by Docker Compose only when compose.db.yaml is used (account database).
# Required; Compose refuses to start while empty. Generate one, e.g. `openssl rand -hex 24`.
# Never commit the real .env.
POSTGRES_PASSWORD=
# Accounts (Better Auth). Empty → account routes answer NOT_CONFIGURED; guest mode is unaffected.
# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Self-service signup has no email verification or recovery: keep false. Create accounts with
# scripts/create-account.mjs instead (docs/docker.md).
ACCORD_SIGNUP_ENABLED=false
