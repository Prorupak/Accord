# Copy to web/.env.local for `pnpm dev`. Guest mode needs none of these.
# PostgreSQL for accounts and sessions. Server-only: never
# prefix with NEXT_PUBLIC_. Prisma commands read it via prisma.config.ts.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Accounts (Better Auth). All three plus DATABASE_URL are needed, else /api/auth/* answers 503
# NOT_CONFIGURED. Secret: at least 32 random characters (`openssl rand -base64 32`). URL: the exact
# origin the browser uses; it is the only trusted origin for auth requests.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Self-service signup is off unless exactly `true`; any other value disables accounts entirely.
# ACCORD_SIGNUP_ENABLED=false
