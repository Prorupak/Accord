{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "fastapi"
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/map",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/suggest",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/capabilities",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
